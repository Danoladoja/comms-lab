+        Awaited<ReturnType<typeof submitPartnershipEnquiry>>,
+        TError,
+        {data: BodyType<PartnershipEnquiryInput>},
+        TContext
+      > => {
+      return useMutation(getSubmitPartnershipEnquiryMutationOptions(options));
+    }
